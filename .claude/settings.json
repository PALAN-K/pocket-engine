{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-sequential-tasks.sh\"",
            "statusMessage": "Checking sequential execution..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-skill-first.sh\"",
            "statusMessage": "Checking skill references..."
          }
        ]
      }
    ]
  }
}
